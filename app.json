{
  "expo": {
    "name": "Recare-fe",
    "slug": "Recare-fe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/shared/assets/images/icon.png",
    "scheme": "recarefe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recare.app"
    },
    "android": {
      "package": "com.recare.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/shared/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/shared/assets/images/android-icon-background.png",
        "monochromeImage": "./src/shared/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/shared/assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 산재 지정 병원을 찾기 위해 위치 정보가 필요해요"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
